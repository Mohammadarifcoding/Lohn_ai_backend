{
  "name": "blog_workflow",
  "version": "1.0.0",
  "description": "Scalable REST API backend with Express, TypeScript, Prisma, and Better Auth",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "env:check": "pnpm tsx scripts/check-env.ts",
    "predev": "pnpm env:check",
    "dev": "nodemon",
    "prebuild": "pnpm env:check",
    "build": "node scripts/generate-prisma-if-available.cjs && tsc && node scripts/copy-generated-prisma.cjs",
    "vercel-build": "pnpm build",
    "postinstall": "node scripts/generate-prisma-if-available.cjs",
    "prestart": "pnpm env:check",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema ../lohnai-website/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../lohnai-website/prisma/schema.prisma",
    "db:push": "prisma db push --schema ../lohnai-website/prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../lohnai-website/prisma/schema.prisma",
    "trigger:sync:dev": "pnpm tsx scripts/trigger-sync-env.ts dev",
    "trigger:sync:prod": "pnpm tsx scripts/trigger-sync-env.ts prod",
    "trigger:sync:all": "pnpm tsx scripts/trigger-sync-env.ts all",
    "trigger:dev": "pnpm dlx trigger.dev dev --config trigger.config.ts --env-file .env.local",
    "pretrigger:deploy": "pnpm trigger:sync:prod",
    "trigger:deploy": "pnpm dlx trigger.dev deploy . --config trigger.config.ts --env prod --env-file .env.production.local",
    "predeploy:preview": "pnpm build",
    "deploy:preview": "vercel",
    "predeploy:prod": "pnpm build",
    "deploy:prod": "vercel --prod",
    "auth:generate": "npx @better-auth/cli generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  },
  "dependencies": {
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.8",
    "@langchain/openai": "^1.4.4",
    "@langchain/pinecone": "^1.0.1",
    "@pinecone-database/pinecone": "^5.1.2",
    "@prisma/client": "^6.19.3",
    "@tavily/core": "^0.7.2",
    "@trigger.dev/sdk": "4.4.5",
    "better-auth": "^1.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "langchain": "^1.3.1",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@trigger.dev/build": "4.4.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
