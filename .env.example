# Copy this file to one of the only supported runtime env files:
# - .env.local for NODE_ENV=development
# - .env.production.local for NODE_ENV=production

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Pinecone (Vector DB)
PINECONE_API_KEY=
PINECONE_INDEX=

# AI Gateway
OPENROUTER_API_KEY=
AI_GATEWAY_URL=

# Tavily (Web Search)
TAVILY_API_KEY=

# Trigger.dev (Background Jobs)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_USE_QUEUE=false

# Blog Research Cache
BLOG_RESEARCH_CACHE_ENABLED=false

# Admin Bootstrap
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Analytics
ANALYTICS_SALT=

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.02
SENTRY_PROFILES_SAMPLE_RATE=0

# ─── Resend (Email Provider) ──────────────────────────────────────────────────
RESEND_API_KEY=
