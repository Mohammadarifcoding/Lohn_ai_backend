# Server
PORT=3000
NODE_ENV=development

# Database (Neon)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pinecone
PINECONE_API_KEY=pc-your-pinecone-api-key-here
PINECONE_INDEX=your-index-name

# AI Gateway / Multi-provider
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY=your-gemini-api-key
AI_GATEWAY_URL=https://api.kilo.ai/api/gateway

# Bootstrap Admin (created automatically on startup if missing)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=Admin@12345678
